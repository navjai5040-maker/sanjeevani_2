{
  "name": "sanjeevani",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "check:python": "python -m compileall services/api",
    "check:types": "npm --workspace packages/shared-types run build"
  }
}
